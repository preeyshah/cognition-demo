# Copy to .env and override for any non-local deployment.
# dev (default): mock SSO IdP + demo seed data enabled. prod: both disabled, JWT_SECRET required.
ENVIRONMENT=dev
JWT_SECRET=change-me-to-a-long-random-string
PROVIDER_API_KEY=demo-provider-key
POSTGRES_PASSWORD=refunds
# Dev-only mock SSO second factor (ignored when ENVIRONMENT=prod)
MOCK_MFA_CODE=123456
# Auto-ticket + Devin session when denied actions spike (0 disables)
GUARDRAIL_ALERT_THRESHOLD=50
GUARDRAIL_ALERT_WINDOW_MINUTES=10
