# Copy to terraform.tfvars (gitignored) or pass -var / TF_VAR_* in CI to override
# any of these in a PR. Everything below is already the default — uncomment to change.

# --- Capacity / autoscaling -------------------------------------------------
# api_min_count        = 2      # autoscaling floor (desired_count seeds the first deploy)
# api_max_count        = 8      # autoscaling ceiling
# api_task_cpu         = 512    # Fargate CPU units (256/512/1024/2048/4096)
# api_task_memory      = 1024   # MiB; must be a valid Fargate cpu/memory combo
# provider_task_cpu    = 256
# provider_task_memory = 512

# --- Database ----------------------------------------------------------------
# db_instance_class         = "db.t4g.micro"   # scale up/down: db.t4g.small, db.r6g.large, ...
# db_allocated_storage      = 20              # GiB
# db_max_allocated_storage  = 100             # storage autoscaling ceiling, GiB
# db_multi_az               = true            # synchronous standby + automatic failover
# db_read_replica           = false           # read replica (offload analytics / DR)
# db_backup_retention_days  = 14              # PITR window
#
# Postgres parameter overrides (merged over the defaults rds.force_ssl=1 and
# log_min_duration_statement=500). RDS accepts {DBInstanceClassMemory/...} formulas
# for memory-relative settings.
# db_parameters = {
#   "work_mem"              = "8MB"
#   "maintenance_work_mem"  = "256MB"
#   "max_connections"       = "200"
#   "shared_buffers"        = "{DBInstanceClassMemory/16384}" # ~1/4 of instance RAM in 8kB blocks
# }

# --- Edge / network ----------------------------------------------------------
# vpc_cidr                  = "10.40.0.0/16"
# waf_rate_limit_per_5min   = 1000
# alert_email               = "oncall@example.com"
# dr_region                 = "us-west-2"

# --- Environment sizing (the dev root sets these small; prod keeps defaults) ----
# az_count                 = 2        # AZs for subnets/NAT
# enable_nat_gateway       = true     # NAT for private subnets (~$32/mo)
# tasks_in_public_subnets  = false    # run ECS tasks publicly (pair with no NAT, dev only)
# enable_waf               = true     # CloudFront WAF web ACL
# enable_autoscaling       = true     # api target-tracking policies
# enable_backup            = true     # AWS Backup plans + cross-region copy
# db_deletion_protection   = true
# db_skip_final_snapshot   = false
